{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "ExecutionSettings": {
    "DockerHost": "unix:///var/run/docker.sock",
    "WorkspaceBasePath": "/tmp/submissions",
    "MaxConcurrentExecutions": 3,
    "CleanupIntervalMinutes": 30
  }
}
