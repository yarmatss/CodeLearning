{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DockerGuard": {
    "DockerSocket": "/var/run/docker.sock",
    "WorkspacePath": "/app",
    "AllowedImages": [
      "codelearning/python:3.12-slim",
      "codelearning/node:22-slim",
      "codelearning/dotnet:10.0",
      "codelearning/java:21-jdk"
    ],
    "AllowedRuntimes": [ "runsc" ]
  }
}
