# Variables marked "required" stop "docker compose" with an error when empty or missing.

# PostgreSQL (all required)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT signing key for the API (required; HMAC-SHA256, use at least 32 random characters)
JWT_SECRET_KEY=

# Redis (required; refresh tokens and the access-token blacklist)
REDIS_PASSWORD=

# RabbitMQ (both required)
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Group id that owns /var/run/docker.sock (required). DockerGuard runs as a non-root user and gets
# socket access only through this group.
#   Docker Desktop (Windows/macOS): 0
#   Docker Engine on Linux or in WSL: run  stat -c %g /var/run/docker.sock  (usually the "docker" group)
DOCKER_SOCKET_GID=

# Optional: subnet of the compose network. The API trusts X-Forwarded-* headers only from it.
# Change it if 172.28.0.0/24 overlaps a network on your host.
# CODELEARNING_SUBNET=172.28.0.0/24

# Optional: longest a sandbox container may run, in seconds (default 300). Passed to both the api and
# the runner: the runner kills a container after this long, and the api rejects problems whose test
# cases x language time limit could not finish within it, so the two must always agree.
# MAX_CONTAINER_RUNTIME_SECONDS=300

# Optional: host port of the frontend (nginx in production, ng serve in development)
# FRONTEND_PORT=4200
