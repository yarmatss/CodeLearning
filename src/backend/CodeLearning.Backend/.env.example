# PostgreSQL
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# JWT signing key for the API (HMAC-SHA256, use at least 32 random characters)
JWT_SECRET_KEY=

# Redis (refresh tokens and the access-token blacklist)
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Group that owns /var/run/docker.sock (0 for Docker Desktop; for Docker Engine in WSL: stat -c %g /var/run/docker.sock)
DOCKER_SOCKET_GID=0
